{
  "name": "verde-kitchen-drupal",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end build for the Verde theme (SCSS and JavaScript).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "watch": "webpack --mode=development --watch",
    "test": "node --test \"web/themes/custom/verde/src/js/**/*.test.js\"",
    "screenshots": "node scripts/screenshots.mjs",
    "audit:site": "node scripts/audit.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"web/themes/custom/**/*.scss\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write . && stylelint --fix \"web/themes/custom/**/*.scss\" && eslint --fix .",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "node scripts/storybook-check.mjs"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "Firefox ESR",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@drupal/once": "^1.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/html-vite": "^10.6.8",
    "autoprefixer": "^10.7.0",
    "axe-core": "^4.14.1",
    "babel-loader": "^10.1.1",
    "chrome-launcher": "^1.2.3",
    "css-loader": "^7.1.5",
    "drupal-attribute": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.33",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "storybook": "^10.6.7",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "^7.3.8",
    "vite-plugin-twig-drupal": "^1.6.2",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "drupal-twig-extensions": {
      "locutus": "^3.0.36"
    },
    "twig": {
      "minimatch": "^11.0.9"
    }
  }
}
