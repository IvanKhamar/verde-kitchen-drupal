# Ukrainian translation of the Verde theme and its React catalog filter.
#
# Drupal imports this file with the interface translations (drush locale:update),
# because verde.info.yml points "interface translation server pattern" here.
# Core and contributed strings come from localize.drupal.org.
msgid ""
msgstr ""
"Project-Id-Version: verde\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=((n%10==1 && n%100!=11) ? 0 : ((n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20)) ? 1 : 2));\n"
"Language: uk\n"

