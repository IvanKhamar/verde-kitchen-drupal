{#
/**
 * @file
 * Theme override for the product catalog page (view "products", display
 * "page_catalog"). File name pattern: views-view--VIEW--DISPLAY.html.twig.
 *
 * The React filter mounts into [data-catalog-filter]. The server-rendered list
 * (#catalog-fallback) is what search engines, users without JavaScript and the
 * first paint see; the widget hides it once its own results are ready.
 *
 * data-* attributes pass settings to JavaScript. Twig escapes their values,
 * so they are safe inside the HTML attribute.
 */
#}
{{ attach_library('verde/catalog-filter') }}
<div{{ attributes.addClass('catalog') }}>
  <div
    class="catalog__filter"
    data-catalog-filter
    data-api-base="{{ path('jsonapi.resource_list') }}"
    data-base-path="{{ path('<front>') }}"
    data-fallback-id="catalog-fallback"
    {#
      Set only in the static copy (GitHub Pages), which has no JSON:API:
      the widget then reads exported JSON files from this folder.
    #}
    {% if static_data_path %}data-static-data="{{ static_data_path }}"{% endif %}
  ></div>
  <div id="catalog-fallback" class="catalog__fallback">
    {{ rows }}
    {{ empty }}
    {{ pager }}
  </div>
</div>
