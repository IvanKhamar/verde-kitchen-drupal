{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Drupal's breadcrumb lists the pages above the current one, not the current
 * page itself, so every item is a link to a parent page and none of them gets
 * aria-current. The separators are drawn with CSS, so screen readers do not
 * read them out.
 */
#}
{% if breadcrumb %}
  <nav class="breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
    <ol class="breadcrumb__list">
      {% for item in breadcrumb %}
        <li class="breadcrumb__item">
          {% if item.url %}
            <a href="{{ item.url }}">{{ item.text }}</a>
          {% else %}
            {{ item.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
