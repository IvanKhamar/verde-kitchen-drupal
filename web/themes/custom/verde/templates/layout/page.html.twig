{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Each region from verde.info.yml is available as page.<region>. A region is
 * empty when no block in it has content, so the {% if %} checks avoid printing
 * empty wrappers.
 *
 * Landmarks (<header>, <nav> inside the menu block, <main>, <footer>) let
 * screen reader users jump between the parts of the page.
 */
#}
<div class="layout">
  {% if static_notice %}
    {# Only in the static copy on GitHub Pages (see verde_preprocess_page()). #}
    <p class="static-notice">
      {{ 'Static preview: no admin and no live API.'|t }}
      <a href="{{ static_notice.url }}">{{ static_notice.label }}</a>
    </p>
  {% endif %}
  <header class="site-header" role="banner">
    <div class="site-header__inner container">
      {{ page.header }}
      {{ page.primary_menu }}
      {#
        Shopping list link with a counter. shopping-list.js fills the counter
        and sets an aria-label such as "Shopping list, 3 items".
      #}
      <a href="{{ path('verde_catalog.shopping_list') }}" class="shopping-list-link" data-shopping-list-link>
        <svg class="shopping-list-link__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M4 7h16l-1.5 11.5a2 2 0 0 1-2 1.5h-9a2 2 0 0 1-2-1.5L4 7Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M9 7V5a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="shopping-list-link__text">{{ 'Shopping list'|t }}</span>
        <span class="shopping-list-link__count" data-shopping-list-count hidden></span>
      </a>
    </div>
  </header>

  {#
    tabindex="-1" lets the skip link move keyboard focus into <main>,
    not only scroll to it.
  #}
  <main id="main-content" class="site-main" tabindex="-1">
    {% if page.highlighted %}
      <div class="container">{{ page.highlighted }}</div>
    {% endif %}
    {% if page.breadcrumb %}
      <div class="container">{{ page.breadcrumb }}</div>
    {% endif %}
    <div class="container">
      {{ page.content }}
    </div>
  </main>

  {% if page.footer %}
    <footer class="site-footer" role="contentinfo">
      <div class="container">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>
